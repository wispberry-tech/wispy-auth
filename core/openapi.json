{
  "openapi": "3.0.3",
  "info": {
    "title": "Wispy Auth API",
    "version": "0.1.0",
    "description": "Built-in endpoints of the Wispy Auth library.\n\nPaths below are the canonical defaults — the library is router-agnostic, so wire the handlers to these paths (or your own) and adjust `servers` accordingly. Authenticated endpoints accept the session token as `Authorization: Bearer <token>` (an `auth_token` cookie is also accepted)."
  },
  "tags": [
    { "name": "Authentication", "description": "Registration, login, session validation" },
    { "name": "Sessions", "description": "Session listing and logout" },
    { "name": "Password Management", "description": "Forgot/reset/change password flows" },
    { "name": "Two-Factor", "description": "TOTP-style email 2FA enable/disable/verify and backup codes" },
    { "name": "OAuth", "description": "Google, GitHub, Discord, and custom OAuth2 providers" }
  ],
  "paths": {
    "/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "operationId": "SignUp",
        "x-handler": "SignUpHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignUpRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created and signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignUpResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/signin": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in with email and password",
        "operationId": "SignIn",
        "x-handler": "SignInHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignInRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated. If `requires_2fa` is true, complete login via POST /2fa/login.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignInResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Log out and invalidate the current session",
        "operationId": "Logout",
        "x-handler": "LogoutHandler",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LogoutResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/validate": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Validate a session token and return the user",
        "operationId": "Validate",
        "x-handler": "ValidateHandler",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Session is valid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidateResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List all active sessions for the current user",
        "operationId": "GetSessions",
        "x-handler": "GetSessionsHandler",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Active sessions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetSessionsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "tags": ["Password Management"],
        "summary": "Request a password reset email",
        "description": "Requires `AllowUserPasswordReset` in SecurityConfig; otherwise returns 403.",
        "operationId": "ForgotPassword",
        "x-handler": "ForgotPasswordHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset requested (sentinel response is returned even for unknown emails)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForgotPasswordResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": ["Password Management"],
        "summary": "Complete a password reset with the emailed token",
        "operationId": "ResetPassword",
        "x-handler": "ResetPasswordHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset; all existing sessions are invalidated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResetPasswordResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/change-password": {
      "post": {
        "tags": ["Password Management"],
        "summary": "Change the current user's password",
        "operationId": "ChangePassword",
        "x-handler": "ChangePasswordHandler",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed; other sessions are invalidated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChangePasswordResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/refresh-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Exchange a refresh token for a new session token",
        "operationId": "RefreshToken",
        "x-handler": "RefreshTokenHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New session token issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshTokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/auth/{provider}": {
      "get": {
        "tags": ["OAuth"],
        "summary": "Initialize an OAuth2 flow for a provider",
        "description": "Returns the provider authorization URL. Supported built-ins: google, github, discord.",
        "operationId": "OAuthInit",
        "x-handler": "OAuthInitHandler",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "OAuth provider name"
          },
          {
            "name": "redirect_url",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Optional URL to return to after the OAuth callback"
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL generated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OAuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/auth/{provider}/callback": {
      "get": {
        "tags": ["OAuth"],
        "summary": "Complete an OAuth2 flow (provider redirects here)",
        "description": "The provider calls this with `code` and `state`. Creates or links the user and returns a session.",
        "operationId": "OAuthCallback",
        "x-handler": "OAuthCallbackHandler",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "OAuth provider name"
          },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Authorization code from the provider"
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "CSRF state token returned by the provider"
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated via OAuth",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OAuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/enable": {
      "post": {
        "tags": ["Two-Factor"],
        "summary": "Start enabling 2FA; sends a verification code by email",
        "operationId": "Enable2FA",
        "x-handler": "Enable2FAHandler",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Enable2FARequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification code sent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Enable2FAResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/enable/verify": {
      "post": {
        "tags": ["Two-Factor"],
        "summary": "Confirm the emailed code and activate 2FA",
        "description": "Returns one-time backup codes. Store them — they are shown only here.",
        "operationId": "VerifyEnable2FA",
        "x-handler": "VerifyEnable2FAHandler",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyEnable2FARequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA enabled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerifyEnable2FAResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/disable": {
      "post": {
        "tags": ["Two-Factor"],
        "summary": "Disable 2FA for the current user",
        "operationId": "Disable2FA",
        "x-handler": "Disable2FAHandler",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Disable2FARequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA disabled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Disable2FAResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/login": {
      "post": {
        "tags": ["Two-Factor"],
        "summary": "Complete sign-in with a 2FA code or backup code",
        "description": "Call after /signin returns `requires_2fa: true`.",
        "operationId": "VerifyLogin2FA",
        "x-handler": "VerifyLogin2FAHandler",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyLogin2FARequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA verified, session issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerifyLogin2FAResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/backup-codes": {
      "get": {
        "tags": ["Two-Factor"],
        "summary": "List the current user's backup codes",
        "operationId": "GetBackupCodes",
        "x-handler": "GetBackupCodesHandler",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Backup codes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetBackupCodesResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/2fa/backup-codes/regenerate": {
      "post": {
        "tags": ["Two-Factor"],
        "summary": "Generate new backup codes, invalidating the old ones",
        "operationId": "RegenerateBackupCodes",
        "x-handler": "RegenerateBackupCodesHandler",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegenerateBackupCodesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New backup codes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegenerateBackupCodesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token. Send as `Authorization: Bearer <token>`. An `auth_token` cookie is also accepted."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request (malformed JSON or validation failure)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or expired credentials/session",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Operation not permitted by configuration",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Conflict": {
        "description": "Resource already exists",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Human-readable error message" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "uuid": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "username": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "avatar_url": { "type": "string", "nullable": true },
          "provider": { "type": "string", "enum": ["email", "google", "github", "discord"] },
          "provider_id": { "type": "string" },
          "email_verified": { "type": "boolean" },
          "is_active": { "type": "boolean" },
          "is_suspended": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "user_id": { "type": "integer", "format": "int64" },
          "token": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "device_fingerprint": { "type": "string" },
          "user_agent": { "type": "string" },
          "ip_address": { "type": "string" },
          "is_active": { "type": "boolean" },
          "last_accessed_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "username": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" }
        }
      },
      "SignUpResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "Session token" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" },
          "session_id": { "type": "integer", "format": "int64" },
          "session_expires_at": { "type": "string", "format": "date-time" },
          "refresh_token": { "type": "string" },
          "requires_2fa": { "type": "boolean", "description": "True when 2FA must be completed via POST /2fa/login" }
        }
      },
      "ValidateResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "GetSessionsResponse": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Session" }
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" }
        }
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "token": { "type": "string", "description": "Reset token; present when an email service is not configured (development only)" }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "password"],
        "properties": {
          "token": { "type": "string", "description": "Password reset token from the reset email" },
          "password": { "type": "string", "format": "password", "minLength": 8 }
        }
      },
      "ResetPasswordResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["current_password", "new_password"],
        "properties": {
          "current_password": { "type": "string", "format": "password" },
          "new_password": { "type": "string", "format": "password", "minLength": 8 }
        }
      },
      "ChangePasswordResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "description": "New session token" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "OAuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "Session token (callback only)" },
          "url": { "type": "string", "description": "Provider authorization URL (init only)" },
          "user": { "$ref": "#/components/schemas/User" },
          "is_new_user": { "type": "boolean" }
        }
      },
      "Enable2FARequest": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": { "type": "string", "format": "password" }
        }
      },
      "Enable2FAResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "VerifyEnable2FARequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "Verification code from email" }
        }
      },
      "VerifyEnable2FAResponse": {
        "type": "object",
        "properties": {
          "backup_codes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "One-time backup codes; shown only here"
          },
          "message": { "type": "string" }
        }
      },
      "Disable2FARequest": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": { "type": "string", "format": "password" }
        }
      },
      "Disable2FAResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "VerifyLogin2FARequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "description": "2FA code from email or a backup code" }
        }
      },
      "VerifyLogin2FAResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "Session token" },
